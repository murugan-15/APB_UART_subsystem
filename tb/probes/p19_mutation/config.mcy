[options]
size 40
# A fixed seed: without it mcy seeds from the clock and the counts change from run to run.
seed 20261115
tags COVERED UNCOVERED

[script]
read_verilog dut.v
prep -top p19_dut

[files]
dut.v

[logic]
if result("test_sim") == "PASS":
    tag("UNCOVERED")
else:
    tag("COVERED")

[report]
print("COVERED %d UNCOVERED %d" % (tags("COVERED"), tags("UNCOVERED")))

[test test_sim]
expect PASS FAIL
run bash $PRJDIR/test_sim.sh
